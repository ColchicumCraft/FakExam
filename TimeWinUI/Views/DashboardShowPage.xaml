<Page
    x:Class="TimeWinUI.Views.DashboardShowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Spacing="16" Padding="20" Margin="10">

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="返回"
                Command="{x:Bind ViewModel.GoBackCommand}"/>
        <Button Content="加载 JSON"
                Command="{x:Bind ViewModel.LoadJsonCommand}"/>
      </StackPanel>
      <TextBlock Text="{x:Bind ViewModel.ExamName, Mode=OneWay}"
                 FontSize="22"
                 FontWeight="SemiBold"
                 TextWrapping="WrapWholeWords"/>
      <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                 FontSize="14"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextWrapping="WrapWholeWords"/>
      <Border CornerRadius="8"
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              Padding="12">
        <TextBlock Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}"
                   FontSize="36"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
      </Border>
      
      <StackPanel Spacing="8"
                  Padding="12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
        <TextBlock Text="当前科目" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock Text="{x:Bind ViewModel.CurrentExamName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/>

        <TextBlock Text="起止时间" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
        <TextBlock Text="{x:Bind ViewModel.CurrentExamTimeRange, Mode=OneWay}" FontSize="16"/>

        <TextBlock Text="剩余时间" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
        <TextBlock Text="{x:Bind ViewModel.RemainingTimeText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>

        <TextBlock Text="状态" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
        <TextBlock Text="{x:Bind ViewModel.CurrentStatusText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
      </StackPanel>
    </StackPanel>

    <Grid Grid.Column="1" Padding="20" Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <controls:DataGrid Grid.Row="1"
                         ItemsSource="{x:Bind ViewModel.ExamRows, Mode=OneWay}"
                         AutoGenerateColumns="False"
                         HeadersVisibility="Column"
                         Margin="0,12,0,0">
        <controls:DataGrid.Columns>
          <controls:DataGridTextColumn Header="时间" Binding="{Binding Date}"/>
          <controls:DataGridTextColumn Header="科目" Binding="{Binding Name}"/>
          <controls:DataGridTextColumn Header="开始" Binding="{Binding Start}"/>
          <controls:DataGridTextColumn Header="结束" Binding="{Binding End}"/>
          <controls:DataGridTextColumn Header="状态" Binding="{Binding Status}"/>
        </controls:DataGrid.Columns>
      </controls:DataGrid>
    </Grid>
  </Grid>
</Page>
