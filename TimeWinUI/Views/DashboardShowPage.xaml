<Page
    x:Class="TimeWinUI.Views.DashboardShowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d">

  <StackPanel Spacing="12" Padding="12" Margin="30">

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="返回"
              Command="{x:Bind ViewModel.GoBackCommand}" />
      <Button Content="加载 JSON"
              Command="{x:Bind ViewModel.LoadJsonCommand}" />
    </StackPanel>

    <controls:DataGrid ItemsSource="{x:Bind ViewModel.ExamInfos, Mode=OneWay}"
              AutoGenerateColumns="False"
              HeadersVisibility="Column">

      <controls:DataGrid.Columns>
        <controls:DataGridTextColumn Header="日期"
                            Binding="{Binding DisplayDate}" />

        <controls:DataGridTextColumn Header="科目"
                            Binding="{Binding Name}" />

        <controls:DataGridTextColumn Header="开始"
                            Binding="{Binding DisplayStartTime}" />

        <controls:DataGridTextColumn Header="结束"
                            Binding="{Binding DisplayEndTime}" />
      </controls:DataGrid.Columns>
    </controls:DataGrid>

  </StackPanel>
</Page>
