<Page
    x:Class="TimeWinUI.Views.TimeShowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea">
        <StackPanel VerticalAlignment="Center">
            <StackPanel 
                Orientation="Horizontal" 
                HorizontalAlignment="Center"
                Spacing="12">
                <TextBlock 
                    Text="{x:Bind ViewModel.DateText, Mode=OneWay}" 
                    FontSize="28" 
                    VerticalAlignment="Center"/>
                <TextBlock 
                    Text="{x:Bind ViewModel.WeekText, Mode=OneWay}" 
                    FontSize="28" 
                    VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock 
                Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" 
                FontSize="72" 
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"/>
        </StackPanel>

        <Grid VerticalAlignment="Bottom" Margin="10,10,10,10">
            <CommandBar 
                HorizontalAlignment="Left" 
                Background="Transparent" 
                IsOpen="False"
                DefaultLabelPosition="Right">
                <AppBarButton Icon="Add" Label="Add"/>
                <AppBarButton Icon="Edit" Label="Edit"/>
                <AppBarButton Icon="Share" Label="Share"/>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Icon="Setting" Label="Settings">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="I" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <CommandBar 
                HorizontalAlignment="Right" 
                Background="Transparent" 
                IsOpen="False" 
                DefaultLabelPosition="Right">
                <AppBarButton 
                    Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                    Icon="FullScreen"
                    Label="全屏"/>
                <AppBarButton 
                    Command="{x:Bind ViewModel.CloseAppCommand}"
                    Icon="Cancel"
                    Label="关闭"/>
                <AppBarButton 
                    Command="{x:Bind ViewModel.ToggleCompactOverlayCommand}"
                    Icon="NewWindow"
                    Label="画中画"/>
            </CommandBar>
        </Grid>
    </Grid>
</Page>