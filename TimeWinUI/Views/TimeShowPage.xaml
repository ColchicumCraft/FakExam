<Page
    x:Class="TimeWinUI.Views.TimeShowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            Spacing="30">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <TextBlock 
                    Text="{x:Bind ViewModel.DateText, Mode=OneWay}" 
                    FontSize="28" 
                    VerticalAlignment="Center"/>
                <TextBlock 
                    Text="{x:Bind ViewModel.WeekText, Mode=OneWay}" 
                    FontSize="28" 
                    VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock 
                Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" 
                FontSize="72" 
                FontWeight="Bold"
                HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                <Button 
                    Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                    Content="&#xE740;" 
                    FontFamily="Segoe Fluent Icons" 
                    Width="40" 
                    Height="40"/>
                <Button 
                    Command="{x:Bind ViewModel.CloseAppCommand}"
                    Content="&#xE8BB;" 
                    FontFamily="Segoe Fluent Icons" 
                    Width="40" 
                    Height="40"/>
                <Button 
                    Command="{x:Bind ViewModel.ToggleCompactOverlayCommand}"
                    Content="&#xE969;" 
                    FontFamily="Segoe Fluent Icons" 
                    Width="40" 
                    Height="40"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>