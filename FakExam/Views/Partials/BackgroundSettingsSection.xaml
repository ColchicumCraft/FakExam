<UserControl
    x:Class="FakExam.Views.Partials.BackgroundSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:FakExam.Helpers"
    mc:Ignorable="d">

    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <helpers:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
        <helpers:EnumConverter x:Key="EnumConverter" />
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <ct:SettingsExpander Header="窗口背景"
                             Description="选择背景类型（材质 / 纯色 / 图片"
                             IsExpanded="True">
            <ComboBox Width="220"
              SelectedValuePath="Tag"
              SelectedValue="{Binding Category, Mode=TwoWay,
                                  Converter={StaticResource EnumConverter},
                                  ConverterParameter='FakExam.Models.BackgroundCategory'}">
                <ComboBoxItem Content="材质" Tag="Material" />
                <ComboBoxItem Content="纯色"    Tag="Color" />
                <ComboBoxItem Content="图片"    Tag="Image" />
            </ComboBox>
            <ct:SettingsExpander.Items>
                <ct:SettingsCard Header="选择基础材质"
                                 Visibility="{Binding IsMaterial, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox Width="160"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding Material, Mode=TwoWay,
                                                          Converter={StaticResource EnumConverter},
                                                          ConverterParameter='FakExam.Models.MaterialType'}">
                            <ComboBoxItem Content="Mica"    Tag="Mica" />
                            <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                        </ComboBox>
                </ct:SettingsCard>
                <ct:SettingsCard Header="选择子材质"
                                 Visibility="{Binding IsMaterial, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox Width="140"
                                  SelectedValuePath="Tag"
                                  Visibility="{Binding Material, Converter={StaticResource EqualsToVisibility}, ConverterParameter='Mica'}"
                                  SelectedValue="{Binding MicaKind, Mode=TwoWay,
                                                          Converter={StaticResource EnumConverter},
                                                          ConverterParameter='FakExam.Models.MicaSubKind'}">
                        <ComboBoxItem Content="Mica"    Tag="Base" />
                        <ComboBoxItem Content="MicaAlt" Tag="BaseAlt" />
                    </ComboBox>
                </ct:SettingsCard>

                <ct:SettingsCard Header="背景颜色Hex"
                                 Visibility="{Binding IsColor, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox Width="140" Text="{Binding ColorHex, Mode=TwoWay}" />
                    </StackPanel>
                </ct:SettingsCard>

                <ct:SettingsCard Header="背景图片"
                                 Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="360"
                                     Text="{Binding ImagePath, Mode=TwoWay}"
                                     PlaceholderText="选择本地图片..." />
                            <Button Content="浏览..." Command="{Binding BrowseImageCommand}" />
                    </StackPanel>
                </ct:SettingsCard>
                <ct:SettingsCard Header="启用遮罩"
                 Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                        <ToggleSwitch IsOn="{Binding MaskEnabled, Mode=TwoWay}" />
                    </ct:SettingsCard>

                <ct:SettingsCard Header="遮罩色 Hex"
                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                                        IsEnabled="{Binding MaskEnabled}">
                    <TextBox Width="140"
                                     Text="{Binding MaskColorHex, Mode=TwoWay}" />
                </ct:SettingsCard>
                <ct:SettingsCard Header="遮罩透明度"
                 Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                    <Slider Width="200"
                                        Minimum="0" Maximum="1" StepFrequency="0.05"
                                        Value="{Binding MaskOpacity, Mode=TwoWay}" />
                </ct:SettingsCard>

                <ct:SettingsCard Header="操作">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="应用"        Command="{Binding ApplyCommand}" />
                        <Button Content="还原未保存"  Command="{Binding ResetViewCommand}" />
                    </StackPanel>
                </ct:SettingsCard>

            </ct:SettingsExpander.Items>
        </ct:SettingsExpander>
    </StackPanel>
</UserControl>